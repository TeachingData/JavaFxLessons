<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="BOTTOM_CENTER" prefHeight="381.0" prefWidth="331.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.gamedemo.TipController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Label text="Tip Calculator">
      <font>
         <Font name="System Bold Italic" size="24.0" />
      </font>
   </Label>
   <Label text="Enter Amount" />
   <TextField fx:id="amountInput" minWidth="-Infinity" prefHeight="25.0" prefWidth="120.0" />
   <Label text="Select Tip %" />
   <ChoiceBox fx:id="tipSelector" prefWidth="150.0" />

    <Label fx:id="resultText" />
    <Button onAction="#handleTipSelection" prefHeight="39.0" prefWidth="84.0" text="Calc">
      <font>
         <Font size="18.0" />
      </font></Button>
</VBox>
